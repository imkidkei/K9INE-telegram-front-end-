<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>K9INE Studio Hub</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        darkbg: '#09090b',
                        cardbg: '#18181b',
                        accent: '#ef4444',
                        success: '#22c55e',
                        danger: '#f87171'
                    }
                }
            }
        }
    </script>

    <script src="https://telegram.org/js/telegram-web-app.js"></script>

    <style>
        .field-error {
            border-color: rgba(248, 113, 113, 0.8) !important;
            box-shadow: 0 0 0 1px rgba(248, 113, 113, 0.2);
        }
    </style>
</head>
<body class="bg-darkbg text-zinc-100 min-h-screen font-sans antialiased p-4 selection:bg-accent selection:text-white">
    <main class="max-w-md mx-auto space-y-6 pb-12">
        <header class="text-center space-y-2 pt-4">
            <div class="inline-block px-3 py-1 bg-accent/10 border border-accent/20 rounded-full text-xs font-semibold tracking-wider text-accent uppercase">
                TMR Records • IP-Secured
            </div>
            <h1 class="text-2xl font-black tracking-tight text-white">K9INE STUDIO</h1>
            <p class="text-xs text-zinc-400">Authenticity • Consistency • Clarity</p>
        </header>

        <section class="bg-cardbg border border-zinc-800 rounded-2xl p-4 shadow-xl">
            <h2 class="text-xs font-bold uppercase tracking-wider text-accent mb-2">Samurai Code & Pledge</h2>
            <p class="text-xs text-zinc-300 leading-relaxed italic">
                "We guarantee no guarantee on the consumer and marketing unless chosen otherwise. What we guarantee is improving your quality of work and experience level."
            </p>
            <p class="text-[11px] text-zinc-500 mt-2">
                Absolute confidentiality and uncompromising dynamic headroom (-12 dBFS).
            </p>
        </section>

        <section class="space-y-3">
            <h2 class="text-sm font-bold uppercase tracking-wider text-zinc-300">Service Architecture & Pricing</h2>

            <div class="space-y-2 text-xs">
                <div class="bg-cardbg border border-zinc-800/80 rounded-xl p-3 flex justify-between items-center gap-3">
                    <div>
                        <div class="font-bold text-white">🎤 Tracking Session (Per Hr)</div>
                        <div class="text-zinc-400 text-[11px]">Calibrated acoustics & mic matching</div>
                    </div>
                    <div class="text-right font-mono font-bold text-accent">$10 - $40</div>
                </div>

                <div class="bg-cardbg border border-zinc-800/80 rounded-xl p-3 flex justify-between items-center gap-3">
                    <div>
                        <div class="font-bold text-white">🔧 Vocal Tuning & Alignment</div>
                        <div class="text-zinc-400 text-[11px]">Harmonic pitch & phase sync</div>
                    </div>
                    <div class="text-right font-mono font-bold text-accent">$12 - $60</div>
                </div>

                <div class="bg-cardbg border border-zinc-800/80 rounded-xl p-3 flex justify-between items-center gap-3">
                    <div>
                        <div class="font-bold text-white">🎚️ Novelty Mixing</div>
                        <div class="text-zinc-400 text-[11px]">Analog saturation & stereo imaging</div>
                    </div>
                    <div class="text-right font-mono font-bold text-accent">$28 - $150</div>
                </div>

                <div class="bg-cardbg border border-zinc-800/80 rounded-xl p-3 flex justify-between items-center gap-3">
                    <div>
                        <div class="font-bold text-white">🚀 Full Production (Zero-to-Hero)</div>
                        <div class="text-zinc-400 text-[11px]">End-to-end master ready production</div>
                    </div>
                    <div class="text-right font-mono font-bold text-accent">$50 - $330</div>
                </div>
            </div>
        </section>

        <section class="bg-cardbg border border-zinc-800 rounded-2xl p-4 shadow-xl space-y-4">
            <h2 class="text-sm font-bold uppercase tracking-wider text-white">Project Intake Form</h2>

            <form id="intakeForm" class="space-y-3 text-xs" novalidate>
                <div>
                    <label for="serviceSelect" class="block text-zinc-400 mb-1 font-medium">Select Service Tier</label>
                    <select id="serviceSelect" name="service" class="w-full bg-zinc-900 border border-zinc-700 rounded-lg p-2.5 text-zinc-200 focus:outline-none focus:border-accent">
                        <option value="Tracking Session">Tracking Session ($10 - $40)</option>
                        <option value="Vocal Tuning & Alignment">Vocal Tuning & Alignment ($12 - $60)</option>
                        <option value="Novelty Mixing">Novelty Mixing ($28 - $150)</option>
                        <option value="Full Production">Full Production Zero-to-Hero ($50 - $330)</option>
                    </select>
                </div>

                <div>
                    <label for="budgetTier" class="block text-zinc-400 mb-1 font-medium">Budget & Access Tier Level</label>
                    <input
                        type="text"
                        id="budgetTier"
                        name="budgetTier"
                        placeholder="e.g. Quality Tier ($85) or Commercial"
                        required
                        class="w-full bg-zinc-900 border border-zinc-700 rounded-lg p-2.5 text-zinc-200 placeholder:text-zinc-500 focus:outline-none focus:border-accent"
                    >
                </div>

                <div>
                    <label for="projectDetails" class="block text-zinc-400 mb-1 font-medium">Artist Name, Genre & Stem Link</label>
                    <textarea
                        id="projectDetails"
                        name="projectDetails"
                        rows="3"
                        placeholder="Artist: Name | Genre: Trap | Link: Google Drive / Dropbox stems (24-bit / 48kHz)"
                        required
                        class="w-full bg-zinc-900 border border-zinc-700 rounded-lg p-2.5 text-zinc-200 placeholder:text-zinc-500 focus:outline-none focus:border-accent"
                    ></textarea>
                </div>

                <div id="status" class="hidden rounded-lg border border-zinc-700 bg-zinc-950 p-2 text-[11px]"></div>

                <button
                    id="submitButton"
                    type="submit"
                    class="w-full bg-accent hover:bg-accent/90 disabled:opacity-60 disabled:cursor-not-allowed text-white font-bold py-3 rounded-xl transition duration-200 shadow-lg shadow-accent/20 cursor-pointer"
                >
                    Submit Project Securely
                </button>
            </form>
        </section>

        <footer class="text-center text-[10px] text-zinc-500 pt-2">
            Technical Rigor: 24-bit Depth / 48 kHz Sample Rate Output Standard.
        </footer>
    </main>

    <script>
        const tg = window.Telegram?.WebApp;
        const form = document.getElementById('intakeForm');
        const statusBox = document.getElementById('status');
        const submitButton = document.getElementById('submitButton');

        function showStatus(message, type = 'info') {
            statusBox.classList.remove('hidden');
            statusBox.classList.remove('border-zinc-700', 'border-red-500', 'border-emerald-500');
            statusBox.classList.add(
                type === 'error' ? 'border-red-500' : type === 'success' ? 'border-emerald-500' : 'border-zinc-700'
            );
            statusBox.textContent = message;
        }

        function clearFieldErrors() {
            form.querySelectorAll('input, textarea').forEach((field) => {
                field.classList.remove('field-error');
            });
        }

        function validateForm() {
            clearFieldErrors();
            const budget = document.getElementById('budgetTier').value.trim();
            const details = document.getElementById('projectDetails').value.trim();

            if (!budget || !details) {
                if (!budget) {
                    document.getElementById('budgetTier').classList.add('field-error');
                }
                if (!details) {
                    document.getElementById('projectDetails').classList.add('field-error');
                }

                showStatus('Please complete all required fields.', 'error');
                return false;
            }

            return true;
        }

        if (!tg) {
            showStatus('Telegram WebApp SDK not detected. Open this page inside Telegram for full functionality.', 'error');
            submitButton.disabled = true;
        } else {
            tg.expand();
            tg.enableClosingConfirmation?.();
        }

        form.addEventListener('submit', function (event) {
            event.preventDefault();

            if (!tg) return;

            if (!validateForm()) {
                return;
            }

            const service = document.getElementById('serviceSelect').value;
            const budget = document.getElementById('budgetTier').value.trim();
            const details = document.getElementById('projectDetails').value.trim();
            const user = tg.initDataUnsafe?.user;

            const payload = {
                user_id: user?.id || 'unknown',
                username: user?.username || 'guest',
                service,
                budget_tier: budget,
                details
            };

            submitButton.disabled = true;
            submitButton.textContent = 'Sending...';
            showStatus('Sending project details...', 'info');

            try {
                tg.sendData(JSON.stringify(payload));
                showStatus('Project sent successfully.', 'success');

                setTimeout(() => {
                    tg.close();
                }, 600);
            } catch (error) {
                console.error('Telegram sendData failed:', error);
                showStatus('Something went wrong while sending your project. Please try again.', 'error');
                submitButton.disabled = false;
                submitButton.textContent = 'Submit Project Securely';
            }
        });
    </script>
</body>
</html>
